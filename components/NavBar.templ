package components

templ NavBar() {
	<style>
	nav {
		margin: 1rem;
		position: relative;
	}

	.nav-header {
		display: none;
	}

	.mobile-title {
		font-size: 1.25rem;
		font-weight: bold;
		color: var(--text-color);
		text-decoration: none;
	}

	.mobile-title:hover {
		color: var(--link-color);
	}

	.nav-controls {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.nav-list {
		list-style-type: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: center;
		gap: 1rem;
	}

	.link {
		display: block;
		color: var(--text-color);
		text-align: center;
		padding: 14px 16px;
		text-decoration: none;
	}

	.link:hover {
		color: var(--link-color);
	}

	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: space-around;
		width: 30px;
		height: 24px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.hamburger span {
		width: 100%;
		height: 3px;
		background-color: var(--text-color);
		border-radius: 2px;
		transition: all 0.3s ease;
	}

	.hamburger.active span:nth-child(1) {
		transform: rotate(45deg) translate(6px, 6px);
	}

	.hamburger.active span:nth-child(2) {
		opacity: 0;
	}

	.hamburger.active span:nth-child(3) {
		transform: rotate(-45deg) translate(6px, -6px);
	}

	.theme-toggle {
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		font-size: 1.25rem;
		color: var(--text-color);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.theme-toggle:hover {
		opacity: 0.7;
	}

	.theme-toggle .sun-icon {
		display: none;
	}

	.theme-toggle .moon-icon {
		display: block;
	}

	[data-theme="light"] .theme-toggle .sun-icon {
		display: block;
	}

	[data-theme="light"] .theme-toggle .moon-icon {
		display: none;
	}

	.desktop-theme-toggle {
		display: flex;
	}

	@media (max-width: 768px) {
		.nav-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.5rem 0;
		}

		.hamburger {
			display: flex;
		}

		.desktop-theme-toggle {
			display: none;
		}

		.nav-links {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease;
		}

		.nav-links.open {
			max-height: 500px;
		}

		.nav-list {
			flex-direction: column;
			align-items: center;
			padding-top: 1rem;
		}

		.link {
			padding: 12px 16px;
		}
	}

	@media (min-width: 769px) {
		.desktop-theme-toggle {
			position: fixed;
			right: 1.5rem;
			bottom: 1.5rem;
		}
	}
</style>
	<nav>
		<div class="nav-header">
			<a href="/" class="mobile-title">Matthew Kennedy</a>
			<div class="nav-controls">
				<button class="theme-toggle" aria-label="Toggle theme" onclick="toggleTheme()">
					<svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
					<svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
				</button>
				<button class="hamburger" aria-label="Toggle navigation menu" onclick="toggleMenu()">
					<span></span>
					<span></span>
					<span></span>
				</button>
			</div>
		</div>
		<div class="nav-links">
			<ul class="nav-list">
				<li><a class="link" href="/">Home</a></li>
				<li><a class="link" href="https://blog.matthew-kennedy.com">Blog</a></li>
				<li><a class="link" href="/now">Now</a></li>
				<li><a class="link" href="/about">About</a></li>
				<li><a class="link" href="/micro">Reel</a></li>
				<li><a class="link" href="/photos">Photos</a></li>
				<li><a class="link" href="/music">Tunes</a></li>
			</ul>
		</div>
		<button class="theme-toggle desktop-theme-toggle" aria-label="Toggle theme" onclick="toggleTheme()">
			<svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
			<svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
		</button>
	</nav>
	<script>
	function toggleMenu() {
		const hamburger = document.querySelector('.hamburger');
		const navLinks = document.querySelector('.nav-links');
		hamburger.classList.toggle('active');
		navLinks.classList.toggle('open');
	}

	function toggleTheme() {
		const html = document.documentElement;
		const currentTheme = html.getAttribute('data-theme') || 'dark';
		const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
		html.setAttribute('data-theme', newTheme);
		localStorage.setItem('theme', newTheme);
	}

	// Initialize theme on page load
	(function () {
		const savedTheme = localStorage.getItem('theme') || 'dark';
		document.documentElement.setAttribute('data-theme', savedTheme);
	})();
</script>
}
